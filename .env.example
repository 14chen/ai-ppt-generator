# 复制为 .env 并填入你自己的 Key
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_EFFORT=low
DEEPSEEK_TEMPERATURE=0.6
DEEPSEEK_MAX_TOKENS=8000

PORT=8787
# 手机 / 微信小程序访问时改成 0.0.0.0
HOST=127.0.0.1

MIN_CHARS=20
MAX_CHARS=20000
MAX_SLIDES=24
REQUEST_TIMEOUT_MS=300000
IDLE_TIMEOUT_MS=90000

# ---- 微信小程序（可选）----
# 配置后 /api/miniprogram/code 会返回真正的小程序码，而不是 H5 二维码
WX_APPID=
WX_SECRET=
# release | trial | develop
WX_ENV_VERSION=release
WX_PAGE=pages/index/index
WX_API_BASE=https://api.weixin.qq.com

# ---- 对外地址（可选）----
# 反向代理 / 正式域名；留空则自动探测局域网 IP
PUBLIC_URL=
# 提示用户填进 miniprogram/config.js 的地址；留空则自动探测局域网 IP
MINIPROGRAM_API_BASE=

# ---- PPTX ----
# 中文必须显式指定字体，否则 PowerPoint 会用主题字体渲染成豆腐块
PPTX_FONT=Microsoft YaHei
