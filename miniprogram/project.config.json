{
  "appid": "touristappid",
  "projectname": "ai-web-ppt",
  "description": "AI 网页 PPT 生成器 · 微信小程序端",
  "compileType": "miniprogram",
  "libVersion": "3.5.0",
  "miniprogramRoot": "./",
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "bigPackageSizeSupport": true,
    "ignoreDevUnusedFiles": false,
    "packNpmManually": false,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "condition": {},
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
