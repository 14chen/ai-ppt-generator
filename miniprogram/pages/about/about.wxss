.steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.step {
  font-size: 26rpx;
  color: #c8d3ea;
  line-height: 1.6;
}

.kv {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.kv-label {
  flex: 0 0 150rpx;
  font-size: 24rpx;
  color: #94a2c2;
}

.kv-value {
  flex: 1 1 auto;
  font-size: 24rpx;
  word-break: break-all;
}

.kv-value.ok { color: #4ade80; }
.kv-value.bad { color: #ff8a8a; }

.tip {
  display: block;
  margin-top: 16rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #94a2c2;
}

.copy-btn {
  margin-top: 22rpx;
}
