.hero { padding: 28rpx; }

.hero-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 6rpx;
}

.source {
  width: 100%;
  height: 380rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background-color: rgba(0, 0, 0, 0.25);
  color: #e9eefb;
  font-size: 26rpx;
  line-height: 1.7;
}

.source-ph { color: #5f6b88; }

.counter-row { margin-top: 14rpx; }
.counter-row .warn { color: #f5b544; }

.field { margin-bottom: 26rpx; }
.field .muted { display: block; margin-bottom: 14rpx; }

.picker {
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background-color: rgba(255, 255, 255, 0.05);
  font-size: 26rpx;
}

.btn.is-disabled { opacity: 0.45; }

.error-box {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background-color: rgba(255, 107, 107, 0.12);
  border: 1rpx solid rgba(255, 107, 107, 0.4);
}

.view-deck { margin-top: 18rpx; }

/* ---------------------------------------------------------------- 实时预览 */

.live-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.thumb {
  position: relative;
  width: 320rpx;
  height: 180rpx;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  background-color: #0b1224;
}

.thumb-scale {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: top left;
}

.thumb-badge {
  position: absolute;
  left: 10rpx;
  top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #e9eefb;
  background-color: rgba(6, 10, 22, 0.72);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
}
