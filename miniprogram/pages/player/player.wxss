.player {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #05070f;
  overflow: hidden;
}

.stage {
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
}

.stage-scale {
  position: absolute;
  left: 0;
  top: 0;
  transform-origin: top left;
}

.zones {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  z-index: 10;
}

.zone { flex: 1 1 0; }
.zone:nth-child(1) { flex: 0 0 30%; }
.zone:nth-child(3) { flex: 0 0 30%; }

.top-bar {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 20;
}

.top-label {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #e9eefb;
  background-color: rgba(10, 14, 28, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.round-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 28rpx;
  background-color: rgba(10, 14, 28, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.notes {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 160rpx;
  padding: 22rpx 26rpx;
  border-radius: 18rpx;
  background-color: rgba(10, 14, 28, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  z-index: 22;
}

.notes-title {
  display: block;
  font-size: 20rpx;
  color: #22d3ee;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.notes-body {
  display: block;
  font-size: 24rpx;
  color: #c8d3ea;
  line-height: 1.6;
}

.hud {
  position: absolute;
  left: 50%;
  bottom: 30rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background-color: rgba(10, 14, 28, 0.82);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  z-index: 25;
  max-width: 92%;
}

.hud-btn {
  min-width: 62rpx;
  height: 62rpx;
  padding: 0 14rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #e9eefb;
  background-color: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.hud-btn-sm {
  min-width: 56rpx;
  height: 56rpx;
  font-size: 26rpx;
}

.dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 300rpx;
  overflow: hidden;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.28);
  flex: 0 0 auto;
}

.dot.is-active {
  width: 34rpx;
  border-radius: 8rpx;
  background-color: #22d3ee;
}

.counter {
  font-size: 22rpx;
  color: #94a2c2;
}
